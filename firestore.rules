rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'ADMIN';
    }

    function isOperator() {
      return isSignedIn() && (getUserData().role == 'ADMIN' || getUserData().role == 'OPERATOR');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -- VALIDATION HELPERS --

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'code', 'sellingPrice', 'currentStock']) &&
             data.name is string && data.name.size() <= 256 &&
             data.code is string && data.code.size() <= 128 &&
             data.sellingPrice is number && data.sellingPrice >= 0 &&
             data.currentStock is number;
    }

    function isValidMovement(data) {
      return data.keys().hasAll(['type', 'productId', 'quantity', 'date', 'userId']) &&
             data.type in ['IN', 'OUT'] &&
             data.productId is string &&
             data.quantity is number && data.quantity > 0 &&
             data.userId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.role in ['ADMIN', 'OPERATOR'];
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'email', 'timestamp', 'type']) &&
             data.userId == request.auth.uid &&
             data.type == 'LOGIN';
    }

    // -- COLLECTIONS --

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().role == 'OPERATOR';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /user_sessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidSession(incoming());
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidProduct(incoming());
    }

    match /movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isOperator() && isValidMovement(incoming());
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isOperator();
      allow update, delete: if isAdmin();
    }
  }
}
