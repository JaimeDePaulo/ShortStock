{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product in inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "categoryId": { "type": "string" },
        "description": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string" },
        "supplierId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "sellingPrice", "currentStock"]
    },
    "Movement": {
      "title": "Movement",
      "description": "Stock movement (IN or OUT)",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "partnerId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "observation": { "type": "string" },
        "userId": { "type": "string" },
        "invoiceId": { "type": "string" }
      },
      "required": ["type", "productId", "quantity", "date", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "System user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "OPERATOR"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "total": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["invoiceNumber", "total", "date"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Stock supplier",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Stock customer",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["name"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "User login session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["LOGIN"] }
      },
      "required": ["userId", "email", "timestamp", "type"]
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Inventory products" },
    "movements": { "schema": "Movement", "description": "Inventory movements" },
    "categories": { "schema": "Category", "description": "Product categories" },
    "users": { "schema": "User", "description": "App users" },
    "invoices": { "schema": "Invoice", "description": "Sales invoices" },
    "suppliers": { "schema": "Supplier", "description": "Stock suppliers" },
    "customers": { "schema": "Customer", "description": "Stock customers" },
    "user_sessions": { "schema": "UserSession", "description": "User login logs" }
  }
}
